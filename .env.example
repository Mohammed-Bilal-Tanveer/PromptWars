# Backend (copy to backend/.env). Placeholders only — never commit real secrets.
APP_ENV=development
APP_NAME=LabLink API
API_PREFIX=/api/v1
DATABASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=25
OPENAI_MAX_INPUT_CHARS=8000
CAMPUS_TIMEZONE=Asia/Kolkata
FRONTEND_ORIGIN=http://localhost:5173
DEMO_MODE=true
LOG_LEVEL=INFO

# Frontend (frontend/.env) — public values only
# VITE_API_BASE_URL=http://localhost:8000/api/v1
# VITE_APP_MODE=demo
