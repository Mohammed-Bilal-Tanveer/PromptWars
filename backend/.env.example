APP_ENV=development
APP_NAME=LabLink API
API_PREFIX=/api/v1
DATABASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=25
OPENAI_MAX_INPUT_CHARS=8000
CAMPUS_TIMEZONE=Asia/Kolkata
FRONTEND_ORIGIN=http://localhost:5173
DEMO_MODE=true
LOG_LEVEL=INFO
W_DEADLINE=0.40
W_WAITING=0.25
W_FAIRNESS=0.20
W_PREFERENCE=0.15
SOLVER_TIME_LIMIT_SECONDS=5
